# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=3002
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Cookie / Session secrets (must be at least 32 chars each)
COOKIE_SECRET=super-secret-cookie-xyz-123-change-me
SESSION_SECRET=super-secret-session-xyz-123-changeme
SESSION_SALT=mq9hDxBVDbspDR6n

# Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true
REDIS_TTL_SECONDS=300

# Google OAuth — get credentials at https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3002/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback

# Frontend URL (used for post-OAuth redirects)
FRONTEND_URL=http://localhost:3001
